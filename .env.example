# Supabase project settings.
# Dashboard: https://supabase.com/dashboard/project/<project-ref>/settings/api

# Project URL. Dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key. Dashboard > Project Settings > API > Project API keys > anon public.
# Safe to expose in the browser; RLS policies enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Dashboard > Project Settings > API > Project API keys > service_role.
# SERVER-ONLY. Bypasses RLS. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
